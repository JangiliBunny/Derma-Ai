# ==============================================================================
# DermaAI Backend - Environment Configuration Template
# Copy this file to .env and configure values before starting the server.
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# MongoDB Connection String
# Local default: mongodb://localhost:27017
# Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dermai_db?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017

# JWT Cryptographic Secret Key (REQUIRED - Application will refuse to start without it)
# Generate a cryptographically secure 64-character hex key via:
#   Linux/macOS/Git Bash: openssl rand -hex 32
#   Windows PowerShell:   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Allowed CORS Origins (Comma-separated list of allowed frontend URLs)
# Local development example: http://localhost:3000,http://127.0.0.1:3000
# Production example: https://dermaai.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model Selection: baseline_20class (default, 20 diseases) | experimental_8class (8 diseases)
MODEL_TYPE=baseline_20class

# Google Gemini API Key for interactive dermatology chat assistant (Optional)
# Obtain from: https://aistudio.google.com/
# If omitted, DermaAI uses its built-in rule-based medical fallback engine.
GEMINI_API_KEY=
